# The README's top GIF: from the menu to a run, its logs, a network call
# opened and a filter. Run as `fdev`.
sleep 2.2s
mark menu
key down
sleep 1.1s
key right
sleep 1.2s
mark platform
key right
sleep 1.2s
mark flavor
key right
sleep 1.6s
mark targets
key enter
sleep 1.4s
key down
sleep 1.4s
mark store
key enter
sleep 1.6s
mark device
key enter
sleep 3.2s
mark progress
sleep 13s
mark logs
key tab
sleep 0.6s
key up
sleep 0.8s
key enter
sleep 2.6s
mark network
key esc
sleep 0.6s
key /
type method:post
key enter
sleep 2.8s
mark filter
key /
key esc
sleep 0.8s
key r
sleep 2.4s
